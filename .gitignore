# Raw data — read-only, never commit (~11 GB)
raw_data/

# Processed/intermediate data — large, reproducible from scripts (~870 MB)
clean_data/
prism_raw/
prism_raw_800m_tx/
intermediate_data/

# Auto-generated by R
Rplots.pdf
.Rhistory
.RData
.Rproj.user/

# Safety net: large binary data file types anywhere in the tree
*.parquet

# Claude Code local settings (machine-specific)
.claude/settings.local.json
**/.claude/settings.local.json

# Nested separate git repository — tracked in its own history
my-project/

# Transient pipeline run/retry logs
DeathStar/prism/logs/

# Python bytecode cache
__pycache__/
